"color:var(--accent-gold);margin-bottom:1rem;\"><circle cx=\"12\" cy=\"12\" r=\"10\" /><polyline points=\"8 12.5 11 15.5 16 9.5\" /></svg>' +\r\n+            '<h3>Thank You</h3>' +\r\n+            '<p>' + (formSuccessMessages[form.name] || 'Your submission has been received. We will be in touch soon.') + '</p>';\r\n+          form.style.display = 'none';\r\n+          form.insertAdjacentElement('afterend', panel);\r\n+          panel.scrollIntoView({ behavior: 'smooth', block: 'center' });\r\n+        } else {\r\n+          throw new Error('Formspree rejected the submission');\r\n+        }\r\n+      } catch (err) {\r\n+        if (submitBtn) {\r\n+          submitBtn.disabled = false;\r\n+          submitBtn.textContent = originalText;\r\n+        }\r\n+        let errorBox = form.querySelector('.form-error');\r\n+        if (!errorBox) {\r\n+          errorBox = document.createElement('div');\r\n+          errorBox.className = 'form-error';\r\n+          form.prepend(errorBox);\r\n+        }\r\n+        errorBox.textContent = 'Something went wrong. Please try again, or message us directly on WhatsApp.';\r\n+      }\r\n+    });\r\n+  });\r\n+\r\n   // ── Active Nav Link ──\r\n   const currentPage = window.location.pathname.split('/').pop() || 'index.html';\r\n   document.querySelectorAll('.nav-links a, .mobile-menu a').forEach(link => {\r\n","tooLarge":false}]}],"ts":1785950375656},{"role":"user","parts":[{"kind":"text","text":"Yes please then generate a proper thank you message, and that pop up needs to appear so smooth and look sp premium as well"}],"ts":1785950376240},{"role":"assistant","parts":[{"kind":"reasoning","id":"p1-7c5cc987","text":"The user wants:\n1. A proper thank-you message (generated).\n2. The success popup to appear smooth and premium.\n\nThe \"pop up\" — my current implementation replaces the form with an inline Thank You card. The user calls it a \"popThe user wants:\n1. A proper, polished thank-you message per form.\n2. The success \"pop up\" to appear smooth and premium.\n\nCurrently my implementation replaces the form with an inline `.form-success` card (fadeIn animation). The user says \"that pop up needs to appear so smooth and look so premium as well\" — so they want a more polished, animated reveal. \n\nLet me design a premium success experience:\n\n**Design:**\n- A modal-style overlay OR an upgraded inline card? The user said \"pop up\" — they likely envision a centered modal/dialog that fades in over the page. A premium modal with:\n  - Dark glass backdrop with blur\n  - A centered gold-framed card\n  - Animated gold check that draws itself (SVG stroke-dash animation)\n  - Headline \"Thank You\" / per-form message\n  - A closing button (\"Continue Browsing\" / ✕)\n  - Smooth entrance: backdrop fades in, card scales up from 0.92 → 1 with a soft glow pulse\n  - Maybe gold particles/confetti — the user earlier liked the particles theme. A subtle gold particle burst would be on-theme and premium.\n\nA modal is nicer than inline replacement for a \"pop up\". Let me build:\n\n1. **HTML/CSS**: `.form-overlay` (fixed, full-screen, rgba(5,5,5,0.8) + backdrop-filter blur, z-index 2000, opacity 0 → 1 transition, pointer-events none until shown) containing `.form-modal` (centered card: dark glass, gold border, gold check SVG with draw animation, h3, p, close button). \n\n2. **JS**: on success — instead of (or in addition to) the inline panel, show the modal: create the overlay, add to body, force reflow, add `.visible` class → transitions run. The check SVG draws via stroke-dashoffset animation. After a moment or on close, remove the overlay.\n\nActually — should I keep the inline card AND the modal? The user wants the \"pop up\" — the modal is the popup. I'll REPLACE the inline card approach with the modal (cleaner). The form hides (display:none) and the modal pops.\n\nPremium details:\n- Check icon draws itself (stroke-dasharray animation ~0.8s)\n- Modal entrance: scale 0.92→1 + opacity, with cubic-bezier easing\n- A soft gold glow pulse behind the check\n- Per-form message + a secondary line (e.g. \"We'll be in touch within 24 hours\")\n- Close button (gold outline, \"Continue\") — clicking closes; also clicking backdrop closes; ESC closes\n- Maybe a few gold particles rising inside the modal — on-theme with the bull's sparks. Subtle: 6-8 spark dots animating up inside the modal on show. Could reuse spark styling.\n\n**Messages** (proper thank-you copy):\n- **Job application**: \"Your application has been received.\" + \"Thank you for applying to Reality FX. Our recruitment team will review your application and be in touch with next steps.\"\n- **General/talent pool**: \"Welcome to the talent pool.\" + \"Thank you — your details have been saved. We'll reach out when a role that suits you opens.\"\n- **Contact**: \"Message sent.\" + \"Thank you for reaching out. We'll get back to you within 24 hours.\"\n- **Evaluation**: \"Assessment received.\" + \"Thank you for sharing your trading profile. Our team will review it and contact you with a personalised recommendation within 24 hours.\"\n\nHeadline per form: \"Application Submitted\", \"You're in the Talent Pool\", \"Message Sent\", \"Assessment Received\". Sub-message per form.\n\nLet me write the messages map with { title, message } objects.\n\n**Implementation plan:**\n\n1. **main.js** — replace the success panel logic with the modal:\n   - On success: hide the form, build the overlay/modal DOM, append to body, requestAnimationFrame to add `.visible`, animate check (the check SVG has the stroke-dasharray CSS animation — starts when added).\n   - Close: button click, backdrop click, ESC.\n   - Keep the error handling as-is (inline error box).\n\n2. **style.css** — add modal styles:\n   - `.form-overlay`: fixed inset 0, display flex center, background rgba(5,5,5,0.75), backdrop-filter blur(8px), opacity 0, pointer-events none, transition opacity 0.4s; `.form-overlay.visible { opacity: 1; pointer-events: auto; }`\n   - `.form-modal`: dark gradient card, gold border, border-radius 24px, padding 3rem, max-width 460px, text-align center, transform scale(0.92) translateY(12px), opacity 0, transition transform 0.5s cubic-bezier + opacity; `.form-overlay.visible .form-modal { transform: none; opacity: 1; }`\n   - Check circle: `.modal-check svg` with stroke-dasharray/dashoffset draw animation (circle: circumference ~62.8; check polyline length ~...). Use pathLength trick: set `pathLength=\"100\"` on circle and polyline, then `stroke-dasharray: 100; stroke-dashoffset: 100;` animate to 0 with delays.\n   - Gold glow behind check: a radial gradient blob pulsing.\n   - Sparkles inside modal: a few `.modal-spark` elements rising (reuse spark-rise-ish or a dedicated keyframe).\n   - Close button: `.modal-close` — gold outline button.\n\nLet me write the check animation:\n```css\n.form-modal .check-circle,\n.form-modal .check-mark {\n  stroke-dasharray: 100;\n  stroke-dashoffset: 100;\n}\n.form-overlay.visible .check-circle {\n  animation: drawStroke 0.7s ease forwards;\n}\n.form-overlay.visible .check-mark {\n  animation: drawStroke 0.5s ease 0.5s forwards;\n}\n@keyframes drawStroke {\n  to { stroke-dashoffset: 0; }\n}\n```\nWith `pathLength=\"100\"` attributes on the SVG shapes. \n\nThe modal entrance + check + message fade sequence:\n```css\n.form-modal { ... opacity: 0; transform: translateY(16px) scale(0.94); transition: opacity 0.5s ease, transform 0.6s cubic-bezier(0.22, 1, 0.36, 1); }\n.form-overlay.visible .form-modal { opacity: 1; transform: translateY(0) scale(1); }\n.form-modal h3 { opacity: 0; transform: translateY(8px); transition: opacity 0.5s ease 0.5s, transform 0.5s ease 0.5s; }\n.form-overlay.visible .form-modal h3 { opacity: 1; transform: none; }\n.form-modal p { ... delay 0.65s }\n.form-modal .modal-close { ... delay 0.85s }\n```\n\nSparkles in modal: 5-6 `.modal-spark` spans, animated rising with fade (like the hero sparks but inside the modal). \n\n**JS modal build:**\n```js\nfunction showSuccessModal(form) {\n  const msg = formSuccessMessages[form.name] || { title: 'Thank You', message: 'Your submission has been received. We will be in touch soon.' };\n  const overlay = document.createElement('div');\n  overlay.className = 'form-overlay';\n  overlay.innerHTML = `\n    <div class=\"form-modal\" role=\"dialog\" aria-modal=\"true\" aria-label=\"${msg.title}\">\n      <span class=\"modal-spark\" style=\"left:18%;top:22%;animation-delay:0s;\"></span>\n      <span class=\"modal-spark\" style=\"left:78%;top:18%;animation-delay:0.6s;\"></span>\n      <span class=\"modal-spark\" style=\"left:26%;top:70%;animation-delay:1.2s;\"></span>\n      <span class=\"modal-spark\" style=\"left:70%;top:66%;animation-delay:1.8s;\"></span>\n      <span class=\"modal-spark\" style=\"left:50%;top:12%;animation-delay:2.4s;\"></span>\n      <div class=\"modal-check\">\n        <svg width=\"72\" height=\"72\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\">\n          <circle class=\"check-circle\" cx=\"12\" cy=\"12\" r=\"10\" pathLength=\"100\" />\n          <polyline class=\"check-mark\" points=\"8 12.5 11 15.5 16 9.5\" pathLength=\"100\" />\n        </svg>\n      </div>\n      <h3>${msg.title}</h3>\n      <p>${msg.message}</p>\n      <button type=\"button\" class=\"modal-close\">Continue</button>\n    </div>`;\n  document.body.appendChild(overlay);\n  requestAnimationFrame(() => requestAnimationFrame(() => overlay.classList.add('visible')));\n  const close = () => {\n    overlay.classList.remove('visible');\n    setTimeout(() => overlay.remove(), 600);\n  };\n  overlay.addEventListener('click', (e) => { if (e.target === overlay) close(); });\n  overlay.querySelector('.modal-close').addEventListener('click', close);\n  document.addEventListener('keydown', function onKey(e) {\n    if (e.key === 'Escape') { close(); document.removeEventListener('keydown', onKey); }\n  });\n}\n```\nHmm — the ESC handler: I remove it on close. Fine. Actually simpler to keep a reference. Let me define close and attach once; the removeEventListener inside... my code removes after close — but if user closes via button, the ESC listener stays registered (leak) — it would close a non-existent overlay on later ESC. Minor but let me handle: store handler and remove in close.\n\nWait — the form hiding: I currently do `form.style.display = 'none'`. With a modal, I should still hide the form (so the page looks clean behind) — actually, the modal overlays everything with a dark blur; keeping the form visible behind is fine (blurred). Hiding the form also hides the \"Sending…\" button — good (it stays \"Sending…\" behind the modal otherwise, misleading). Let me hide the form AND reset its state on close? If the user closes and the form is hidden, they see nothing — hmm. \n\nBetter UX: hide the form, show modal. On close, RESET the form (clear fields + re-show) so the user can submit again — OR keep it hidden with a subtle \"submitted\" state. For simplicity and premium feel: on close, show the form again but reset (fields cleared, button restored). Actually — for the multi-step evaluation form, resetting means back to step 1. That's fine.\n\nLet me do: on close → form.style.display = '' (restore), form.reset(), and if the form has steps (evaluation), reset to step 1? The main.js has the multi-step logic with showFormStep — my handler runs in the same DOMContentLoaded scope, so I can call showFormStep(0) if formSteps exist. Hmm — but the modal close is async; formSteps is in scope. Let me add: after close, `form.reset()` and if form classList contains... simpler: `form.reset()`; and call showFormStep(0) — but showFormStep is defined in main.js's multi-step section — accessible. But careful: showFormStep is defined only if... it's defined unconditionally in the multi-step block? It's defined when formSteps... let me check: `const formSteps = document.querySelectorAll('.form-step'); ... function showFormStep(index) {..