dient(ellipse at center, black 45%, transparent 92%),\n    linear-gradient(to top, transparent 0%, black 25%),\n    linear-gradient(to right, black 60%, transparent 97%);\n  -webkit-mask-image:\n    radial-gradient(ellipse at center, black 45%, transparent 92%),\n    linear-gradient(to top, transparent 0%, black 25%),\n    linear-gradient(to right, black 60%, transparent 97%);\n  mask-composite: intersect, intersect;\n  -webkit-mask-composite: source-in, source-in;\n}\n\n/* ── Hover — the bull brightens and its energy warms up ── */\n.hero-visual:hover img {\n  opacity: 0.85;\n  filter: drop-shadow(0 0 60px rgba(201, 162, 39, 0.35));\n}\n\n/* The breathing aura only warms up on hover */\n.hero-visual:hover::before {\n  opacity: 1;\n  animation: bull-breathe 7s ease-in-out infinite;\n}\n\n.hero-visual:hover::after {\n  transform: translateX(-50%) scaleX(1.08);\n  opacity: 0.85;\n}\n\n.hero-visual:hover .spark {\n  animation-duration: 4.5s;\n}\n\n@keyframes bull-breathe {\n  0%,\n  100% {\n    transform: scale(1);\n    opacity: 0.75;\n  }\n\n  50% {\n    transform: scale(1.12);\n    opacity: 1;\n  }\n}\n```\n\nReplace with:\n\n```\n/* Golden glow platform — soft breathing halo that grounds the bull */\n.hero-visual::before {\n  content: '';\n  position: absolute;\n  width: 88%;\n  height: 88%;\n  border-radius: 50%;\n  background: radial-gradient(circle at center,\n      rgba(201, 162, 39, 0.16),\n      rgba(201, 162, 39, 0.05) 45%,\n      transparent 70%);\n  filter: blur(12px);\n  opacity: 0.9;\n  animation: bull-breathe 8s ease-in-out infinite;\n  pointer-events: none;\n  z-index: 0;\n}\n\n/* Soft elliptical shadow that grounds the bull on the page */\n.hero-visual::after {\n  content: '';\n  position: absolute;\n  bottom: 0%;\n  left: 50%;\n  width: 62%;\n  height: 7%;\n  transform: translateX(-50%);\n  background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.55), transparent 70%);\n  border-radius: 50%;\n  pointer-events: none;\n  z-index: 0;\n}\n\n/* The b