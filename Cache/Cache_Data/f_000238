; background: rgba(192,57,43,.13); color: #f0a69e; }\n+.q-opt.dim { opacity: .45; }\n+.quiz-fb { margin-top: 16px; padding: 14px 18px; border-radius: 10px; font-size: 14px; }\n+.quiz-fb.good { background: rgba(46,139,87,.12); border: 1px solid rgba(46,139,87,.4); }\n+.quiz-fb.bad { background: rgba(192,57,43,.1); border: 1px solid rgba(192,57,43,.35); }\n+\n+/* Finish + poll */\n+.finish-card, .poll-card {\n+  margin-top: 22px; text-align: center;\n+  background: var(--bg-card); border: 1px solid var(--border-subtle);\n+  border-radius: 14px; padding: 40px 34px;\n+}\n+.finish-ic { font-size: 46px; margin-bottom: 12px; }\n+.finish-card h2 { margin-bottom: 14px; }\n+.finish-score { font-size: 16px; margin-bottom: 8px; color: var(--text-body); }\n+.finish-score.pass strong { color: var(--ok); }\n+.finish-score.fail strong { color: var(--danger); }\n+.finish-card .btn-gold { margin-top: 18px; }\n+.poll-card { text-align: left; margin-top: 20px; }\n+.poll-opt {\n+  display: flex; align-items: center; gap: 14px;\n+  background: #171717; border: 1px solid var(--glass-border);\n+  color: var(--text-body); padding: 14px 18px; border-radius: 10px;\n+  cursor: pointer; font-family: var(--font-body); font-size: 14px;\n+  transition: var(--transition); width: 100%;\n+}\n+.poll-opt:hover { border-color: var(--accent-gold); }\n+.poll-opt.sel { border-color: var(--accent-gold); background: var(--accent-gold-dim); }\n+.poll-pct { font-weight: 700; color: var(--accent-gold-light); font-size: 12px; width: 64px; }\n+\n+/* ============================================================\n+   CERTIFICATE\n+   ============================================================ */\n+.cert-wrap { max-width: 780px; margin: 0 auto; text-align: center; }\n+.cert {\n+  position: relative; background: #f6f2e7;\n+  color: #1c1a14; padding: 56px 48px; border-radius: 4px;\n+  box-shadow: 0 30px 80px rgba(0,0,0,.5);\n+  margin-bottom: 26px; overflow: hidden;\n+}\n+.cert-border { position: absolute; inset: 14px; border: 2px solid #c9a227; pointer-events: none; }\n+.cert::before, .cert::after {\n+  content: \"◆\"; position: absolute; color: #c9a227; font-size: 18px;\n+}\n+.cert::before { top: 26px; left: 30px; } .cert::after { bottom: 26px; right: 30px; }\n+.cert-brand { font-size: 26px; letter-spacing: 6px; font-weight: 700; }\n+.cert-sub { font-size: 13px; letter-spacing: 2px; text-transform: uppercase; color: #666; margin: 18px 0 6px; }\n+.cert-name { font-size: 40px; font-weight: 700; }\n+.cert-course { font-family: var(--font-heading); font-size: 21px; color: #8a6d1f; margin-top: 4px; }\n+.cert-line { font-family: var(--font-quote); font-style: italic; font-size: 17px; color: #555; margin: 20px 0 26px; }\n+.cert-foot { display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #d8d2bf; padding-top: 20px; text-align: left; font-size: 12px; color: #444; }\n+.cert-label { font-size: 9px; letter-spacing: 2px; text-transform: uppercase; color: #999; }\n+.cert-seal {\n+  width: 64px; height: 64px; border-radius: 50%;\n+  border: 2px solid #c9a227; color: #8a6d1f;\n+  display: flex; align-items: center; justify-content: center;\n+  font-family: var(--font-heading); font-weight: 700; font-size: 17px;\n+  box-shadow: inset 0 0 0 3px #f6f2e7, inset 0 0 0 5px #c9a227;\n+}\n+.cert-locked { text-align: center; padding: 60px 20px; }\n+.cert-locked .finish-ic { font-size: 54px; }\n+\n+/* ============================================================\n+   RESPONSIVE\n+   ============================================================ */\n+@media (max-width: 920px) {\n+  .sidebar {\n+    position: fixed; left: 0; top: 0; bottom: 0;\n+    transform: translateX(-100%); transition: var(--transition);\n+    box-shadow: 30px 0 60px rgba(0,0,0,.5);\n+  }\n+  .sidebar.open { transform: translateX(0); }\n+  .topbar {\n+    display: flex; align-items: center; gap: 14px;\n+    padding: 18px 20px; border-bottom: 1px solid var(--glass-border);\n+    position: sticky; top