orm-origin: center;\n  filter: drop-shadow(0 0 5px rgba(201, 162, 39, 0.35));\n}\n\n.hero-visual .hero-arcs .arc-1 {\n  animation: arc-orbit 26s linear infinite;\n}\n\n.hero-visual .hero-arcs .arc-2 {\n  animation: arc-orbit 44s linear infinite reverse;\n}\n\n.hero-visual .hero-arcs .arc-3 {\n  animation: arc-orbit 19s linear infinite reverse;\n}\n\n@keyframes arc-orbit {\n  from {\n    transform: rotate(0deg);\n  }\n\n  to {\n    transform: rotate(360deg);\n  }\n}\n\n/* ── Ground dust explosion — the charge kicks up a wide cloud ── */\n.hero-visual .ground-dust {\n  position: absolute;\n  bottom: -2%;\n  left: 50%;\n  transform: translateX(-50%);\n  width: 118%;\n  height: 40%;\n  border-radius: 50%;\n  background:\n    radial-gradient(ellipse at 32% 82%, rgba(201, 162, 39, 0.24), transparent 62%),\n    radial-gradient(ellipse at 55% 92%, rgba(201, 162, 39, 0.16), transparent 55%),\n    radial-gradient(ellipse at 76% 84%, rgba(201, 162, 39, 0.14), transparent 60%);\n  filter: blur(12px);\n  mix-blend-mode: screen;\n  opacity: 0;\n  pointer-events: none;\n  z-index: 0;\n  animation: ground-billow 12s ease-in-out infinite;\n}\n\n.hero-visual .ground-dust-2 {\n  width: 90%;\n  height: 30%;\n  bottom: 4%;\n  opacity: 0;\n  filter: blur(18px);\n  animation: ground-billow 16s ease-in-out infinite reverse;\n}\n\n@keyframes ground-billow {\n  0%,\n  100% {\n    transform: translateX(-50%) scaleX(0.94);\n    opacity: 0;\n  }\n\n  28% {\n    opacity: 0.85;\n  }\n\n  55% {\n    transform: translateX(-50%) scaleX(1.12);\n    opacity: 0.5;\n  }\n}\n\n/* Fine dust grains scattered along the ground, drifting upward */\n.hero-visual .ground-grain {\n  position: absolute;\n  width: 4px;\n  height: 4px;\n  border-radius: 50%;\n  background: var(--accent-gold-light);\n  box-shadow: 0 0 8px 2px rgba(201, 162, 39, 0.45);\n  opacity: 0;\n  pointer-events: none;\n  z-index: 2;\n  animation: grain-drift 9s ease-in-out infinite;\n}\n\n@keyframes grain-drift {\n  0% {\n    transform: translate(0, 0) scale(0.5);\n    opacity: 0;\n  }\n\n  15% {\n    opacity: 0.8;\n  }\n\n  55% {\n    opacity: 0.35;\n  }\n\n  100% {\n    transform: translate(-46px, -120px) scale(1.25);\n    opacity: 0;\n  }\n}\n\n/* Hover — arcs brighten, dust billows wider, grains rise faster */\n.hero-visual:hover .hero-arcs {\n  opacity: 1;\n}\n\n.hero-visual:hover .hero-arcs .arc {\n  filter: drop-shadow(0 0 9px rgba(201, 162, 39, 0.55));\n}\n\n.hero-visual:hover .ground-dust,\n.hero-visual:hover .ground-dust-2 {\n  animation-duration: 7s, 10s;\n}\n\n.hero-visual:hover .ground-grain {\n  animation-duration: 6s;\n}\n\n.chart-art-wrap {","allowMultiple":false}]}},{"kind":"text","text":"\n"},{"kind":"reasoning","id":"p12-ea2428e6","text":"Now let me verify the changes in the preview. First let me check the preview setup — the preview was registered earlier. Let me check the preview state and register the preview. Let me look at the run doc and check the current preview state.","open":false,"collapse":"preview"},{"kind":"text","text":"Both edits are in. Let me check the preview setup and verify visually:"},{"kind":"tool","id":"03mlnZoJmn8","toolName":"write_todos","input":{"todos":[{"task":"Add golden orbital arc lines (upper right) + ground dust explosion + scattered dust specks to hero-visual in index.html","completed":true},{"task":"Add CSS for arcs, dust burst, and specks with slow elegant animation + hover warm-up","completed":true},{"task":"Verify visually in the live preview","completed":false}]}},{"kind":"tool","id":"03mmD8s2rQE","toolName":"read_files","input":{"paths":[".freebuff/run.md"]}},{"kind":"reasoning","id":"p13-ea2428e6","text":"No run doc. The preview earlier was served from the file directly. Let me register the preview with the HTML path.","open":false,"collapse":"preview"},{"kind":"text","text":"The preview is a simple static HTML file — I'll register it directly:"},{"kind":"tool","id":"03n3Hc8He5U","toolName":"register_preview","input":{"htmlPath":"REALITY-FOREX-