"path":"REALITY-FOREX-TRADING-/css/style.css","replacements":[{"oldString":".chart-art {\n  position: relative;\n  z-index: 1;\n  width: 100%;\n  max-width: 480px;\n  height: auto;\n  display: block;\n}","newString":".chart-art {\n  position: relative;\n  z-index: 1;\n  width: 100%;\n  max-width: 480px;\n  height: auto;\n  display: block;\n}\n\n/* ============================================\n   CAREERS PAGE\n   ============================================ */\n\n/* ── Hero: subtle trading-desk grid + gold glows ── */\n.careers-hero {\n  background:\n    radial-gradient(ellipse at 15% 20%, rgba(201, 162, 39, 0.10), transparent 55%),\n    radial-gradient(ellipse at 85% 80%, rgba(201, 162, 39, 0.07), transparent 50%),\n    linear-gradient(rgba(255, 255, 255, 0.015) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(255, 255, 255, 0.015) 1px, transparent 1px),\n    var(--bg-primary);\n  background-size: auto, auto, 60px 60px, 60px 60px, auto;\n}\n\n/* ── Why Join / Benefits icon boxes ── */\n.icon-emoji {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 52px;\n  height: 52px;\n  font-size: 1.6rem;\n  background: rgba(201, 162, 39, 0.1);\n  border: 1px solid var(--border-subtle);\n  border-radius: 12px;\n  margin-bottom: 1.25rem;\n}\n\n.why-grid .card p {\n  margin-bottom: 0;\n}\n\n/* ── Culture values ── */\n.value-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 1.25rem;\n}\n\n.value-card {\n  background: linear-gradient(145deg, #141414, #0c0c0c);\n  border: 1px solid var(--glass-border);\n  border-radius: 14px;\n  padding: 1.75rem 1.5rem;\n  transition: var(--transition);\n}\n\n.value-card:hover {\n  border-color: var(--border-subtle);\n  transform: translateY(-3px);\n}\n\n.value-number {\n  font-family: var(--font-heading);\n  font-size: 2.2rem;\n  color: var(--accent-gold);\n  opacity: 0.55;\n  line-height: 1;\n  display: block;\n  margin-bottom: 0.75rem;\n}\n\n.value-card h3 {\n  font-size: 1.1rem;\n  margin-bottom: 0.35rem;\n}\n\n.value-card p {\n  font-size: 0.85rem;\n  margin: 0;\n}\n\n/* ── Open positions ── */\n.department-group {\n  margin-bottom: 3.5rem;\n}\n\n.department-group:last-child {\n  margin-bottom: 0;\n}\n\n.department-title {\n  font-family: var(--font-body);\n  font-size: 0.85rem;\n  font-weight: 600;\n  letter-spacing: 0.2em;\n  text-transform: uppercase;\n  color: var(--accent-gold);\n  border-bottom: 1px solid var(--glass-border);\n  padding-bottom: 0.75rem;\n  margin-bottom: 1.5rem;\n}\n\n.job-head {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  gap: 1rem;\n  margin-bottom: 0.75rem;\n}\n\n.job-badge {\n  font-size: 0.65rem;\n  font-weight: 600;\n  letter-spacing: 0.15em;\n  text-transform: uppercase;\n  padding: 0.35rem 0.85rem;\n  border-radius: 20px;\n  background: rgba(201, 162, 39, 0.12);\n  color: var(--accent-gold);\n  border: 1px solid var(--border-subtle);\n  white-space: nowrap;\n  flex-shrink: 0;\n}\n\n.job-meta span {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.35rem;\n}\n\n.job-listing .btn {\n  margin-top: 0.5rem;\n}\n\n/* ── Hiring process timeline ── */\n.timeline {\n  position: relative;\n  max-width: 720px;\n  margin: 0 auto;\n}\n\n.timeline::before {\n  content: '';\n  position: absolute;\n  left: 15px;\n  top: 14px;\n  bottom: 14px;\n  width: 2px;\n  background: linear-gradient(180deg, var(--accent-gold), rgba(201, 162, 39, 0.08));\n}\n\n.timeline-item {\n  position: relative;\n  padding: 0 0 2.5rem 4.5rem;\n}\n\n.timeline-item:last-child {\n  padding-bottom: 0;\n}\n\n.timeline-dot {\n  position: absolute;\n  left: 0;\n  top: 0;\n  width: 32px;\n  height: 32px;\n  border-radius: 50%;\n  background: linear-gradient(145deg, #1c1c1c, #0d0d0d);\n  border: 1px solid var(--accent-gold);\n  color: var(--accent-gold);\n  font-family: var(--font-heading);\n  font-size: 0.85rem;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: 1;\n  box-shadow: 0 0 0 5px rgba(201, 162, 39, 0.06);\n}\n\n.timeline-content {\n  background: var(--glass-bg);\n  border: 1px solid var(--glass-border);\n  border-radius: 12px;\n  padding: 1.4rem 1.6rem;\n  transition: var(--transition);\n}\n\n.timeline-content:hover {\n  border-color: var(--border-subtle);\n  transform: translateY(-2px);\n}\n\n.timeline-content h3 {\n  font-size: 1.05rem;\n  margin-bottom: 0.3rem;\n}\n\n.timeline-content p {\n  font-size: 0.85rem;\n  margin: 0;\n  line-height: 1.7;\n}\n\n/* ── Benefits grid ── */\n.benefit-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));\n  gap: 1.25rem;\n}\n\n.benefit-item {\n  background: var(--glass-bg);\n  border: 1px solid var(--glass-border);\n  border-radius: 14px;\n  padding: 1.75rem 1.5rem;\n  transition: var(--transition);\n}\n\n.benefit-item:hover {\n  border-color: var(--border-subtle);\n  transform: translateY(-3px);\n}\n\n.benefit-item .icon-emoji {\n  margin-bottom: 1rem;\n}\n\n.benefit-item h3 {\n  font-size: 1rem;\n  margin-bottom: 0.3rem;\n}\n\n.benefit-item p {\n  font-size: 0.82rem;\n  margin: 0;\n  line-height: 1.6;\n}\n\n@media (max-width: 640px) {\n  .value-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .job-head {\n    flex-direction: column;\n  }\n\n  .timeline-item {\n    padding-left: 3.75rem;\n  }\n}","allowMultiple":false}]}},{"kind":"text","text":"\n"},{"kind":"ad","id":"p6-42b36ae1","ad":{"adText":"Build high-quality, responsive web apps faster with Shadcn Blocks' 1,300+ copy-paste ready components and templates.","title":"Build Efficiently with Responsive Shadcnblocks Components","cta":"Start Building","url":"https://www.shadcnblocks.com/?via=zach","favicon":"https://icons.duckduckgo.com/ip3/www.shadcnblocks.com.ico","clickUrl":"https://api.trygravity.ai/track/click?p=gAAAAABqc0Xrb6jgEqD0iF9xTOewJxd_aRZsI_zHSYNkdbKCESfHMG8gKrjPHVePzHqdSPltGIIh3wGZkUUjUTe-uFvyqsAJi3pIrQdZ4LI7FFp4AwXoJge63_wnBPtaQllrG1QxQAUNDqFo4MdhCTGPuOMY7VhFiyPjUhAhiqcCTEl6NDAYF8PE3Kb83oq7kI_3l