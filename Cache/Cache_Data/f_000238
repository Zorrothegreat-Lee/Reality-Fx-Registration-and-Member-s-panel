: 12px; padding: 16px 20px;\n+  transition: var(--transition);\n+}\n+.insight-item:hover { border-color: var(--border-subtle); transform: translateX(4px); }\n+.insight-item.warn { border-left-color: var(--danger); }\n+.ins-ic { margin-top: 2px; }\n+.ins-ic svg { width: 18px; height: 18px; color: var(--accent-gold); }\n+.insight-item.warn .ins-ic svg { color: #f0a69e; }\n+.insight-item b { display: block; font-size: 14.5px; color: var(--accent-gold-light); margin-bottom: 3px; }\n+.insight-item p { font-size: 13.5px; line-height: 1.6; color: var(--text-muted); }\n+\n /* Quiz */\n .quiz-card {\n   margin-top: 22px; background: var(--bg-card);\n@@ -383,7 +419,30 @@\n   background: var(--bg-card); border: 1px solid var(--border-subtle);\n   border-radius: 14px; padding: 40px 34px;\n }\n-.finish-ic { font-size: 46px; margin-bottom: 12px; }\n+.finish-ic { font-size: 46px; margin-bottom: 12px; color: var(--accent-gold); display: flex; justify-content: center; }\n+.finish-ic svg { width: 46px; height: 46px; }\n+.finish-sub { font-size: 14px; color: var(--text-muted); margin-bottom: 18px; }\n+\n+/* Score-surprise reveal */\n+.score-reveal { margin-top: 24px; animation: revealIn .7s cubic-bezier(.25,.46,.45,.94) both; }\n+@keyframes revealIn { from { opacity: 0; transform: translateY(16px) scale(.97); } to { opacity: 1; transform: translateY(0) scale(1); } }\n+.reveal-score { font-family: var(--font-heading); font-size: 64px; font-weight: 700; line-height: 1; }\n+.reveal-score.pass { color: #9fe3bd; text-shadow: 0 0 24px rgba(46,139,87,.5); }\n+.reveal-score.fail { color: #f0a69e; text-shadow: 0 0 24px rgba(192,57,43,.4); }\n+.reveal-score small { font-family: var(--font-body); font-size: 18px; color: var(--text-muted); font-weight: 500; }\n+.calib-card {\n+  margin: 16px auto 0; max-width: 520px; text-align: left;\n+  display: flex; gap: 12px; align-items: flex-start;\n+  padding: 14px 18px; border-radius: 10px; font-size: 13.5px; line-height: 1.6;\n+  border: 1px solid var(--glass-border); background: #151515;\n+}\n+.calib-card svg { width: 18px; height: 18px; flex-shrink: 0; margin-top: 2px; }\n+.calib-card.aligned { border-color: rgba(46,139,87,.45); background: rgba(46,139,87,.08); color: #cfeede; }\n+.calib-card.aligned svg { color: #9fe3bd; }\n+.calib-card.humble { border-color: rgba(201,162,39,.5); background: rgba(201,162,39,.07); color: #f3e3b8; }\n+.calib-card.humble svg { color: var(--accent-gold-light); }\n+.calib-card.reality { border-color: rgba(192,57,43,.45); background: rgba(192,57,43,.08); color: #f4d4cf; }\n+.calib-card.reality svg { color: #f0a69e; }\n .finish-card h2 { margin-bottom: 14px; }\n .finish-score { font-size: 16px; margin-bottom: 8px; color: var(--text-body); }\n .finish-score.pass strong { color: var(--ok); }\n","tooLarge":false},{"path":"REALITY-FOREX-TRADING-\\os\\index.html","status":"modified","lockfile":false,"binary":false,"adds":1,"dels":0,"patch":"Index: REALITY-FOREX-TRADING-\\os\\index.html\n===================================================================\n--- REALITY-FOREX-TRADING-\\os\\index.html\tbefore\n+++ REALITY-FOREX-TRADING-\\os\\index.html\tafter\n@@ -28,6 +28,7 @@\n     <nav class=\"nav\">\n       <a class=\"nav-item active\" data-route=\"#/\"><span class=\"ni-ic\">🏛️</span>Dashboard</a>\n       <a class=\"nav-item\" data-route=\"#/map\"><span class=\"ni-ic\">🗺️</span>Journey</a>\n+      <a class=\"nav-item\" data-route=\"#/progress\"><span class=\"ni-ic\">📊</span>Performance</a>\n       <a class=\"nav-item\" data-route=\"#/certificate\"><span class=\"ni-ic\">🎓</span>Certificate</a>\n       <a class=\"nav-item\"><span class=\"ni-ic\">📝</span>Trade Journal<span class=\"ni-soon\">SOON</span></a>\n       <a class=\"nav-item\" data-route=\"#/lab\"><span class=\"ni-ic\">🧪</span>Laboratory</a>\n","tooLarge":false},{"path":"REALITY-FOREX-TRADING-\\os\\js\\data.js","status":"modified","lockfile":false,"binary":false,"adds":24,"dels":9,"patch":"Index: REALITY-FOREX-TRADING-\\os\\js\\data.j